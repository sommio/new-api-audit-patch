 	storage, err := common.GetBodyStorage(c)
 	if err != nil {
 		return nil, "unreadable"
@@ -297,6 +303,9 @@ func auditMessages(c *gin.Context, request dto.Request, relayMode int) (json.Raw
 	if err != nil {
 		return nil, "unreadable"
 	}
+	if relayFormat == types.RelayFormatClaude {
+		return extractAnthropicMessages(request, body)
+	}
 	switch relayMode {
 	case relayconstant.RelayModeChatCompletions:
 		return extractChatMessages(request, body)
@@ -357,6 +366,66 @@ func extractResponsesMessages(request dto.Request, body []byte) (json.RawMessage
 	return nil, "raw_only"
 }
 
+func extractAnthropicMessages(request dto.Request, body []byte) (json.RawMessage, string) {
+	if _, ok := request.(*dto.ClaudeRequest); !ok {
+		return nil, "raw_only"
+	}
+	var envelope struct {
+		System   json.RawMessage `json:"system"`
+		Messages json.RawMessage `json:"messages"`
+	}
+	if err := json.Unmarshal(body, &envelope); err != nil {
+		return nil, "unreadable"
+	}
+
+	messages := make([]json.RawMessage, 0)
+	if len(envelope.System) > 0 && string(envelope.System) != "null" {
+		system, err := json.Marshal(struct {
+			Role    string          `json:"role"`
+			Content json.RawMessage `json:"content"`
+		}{Role: "system", Content: envelope.System})
+		if err != nil {
+			return nil, "unreadable"
+		}
+		messages = append(messages, system)
+	}
+	if len(envelope.Messages) == 0 || string(envelope.Messages) == "null" {
+		if len(messages) == 0 {
+			return nil, "raw_only"
+		}
+		result, err := json.Marshal(messages)
+		if err != nil {
+			return nil, "unreadable"
+		}
+		return result, "available"
+	}
+
+	var original []json.RawMessage
+	if err := json.Unmarshal(envelope.Messages, &original); err != nil {
+		return nil, "unreadable"
+	}
+	if len(original) == 0 {
+		return nil, "raw_only"
+	}
+	for _, message := range original {
+		var role struct {
+			Role string `json:"role"`
+		}
+		if err := json.Unmarshal(message, &role); err != nil {
+			return nil, "unreadable"
+		}
+		if role.Role != "user" && role.Role != "assistant" {
+			return nil, "raw_only"
+		}
+		messages = append(messages, message)
+	}
+	result, err := json.Marshal(messages)
+	if err != nil {
+		return nil, "unreadable"
+	}
+	return result, "available"
+}
+
 func auditConversation(c *gin.Context, request dto.Request) (string, string) {
 	if value := strings.TrimSpace(c.GetHeader("Session_id")); value != "" {
 		return audit.ConversationID(value), "session_id"
diff --git a/controller/relay_audit_test.go b/controller/relay_audit_test.go
index db2865c5..ae5197e5 100644
--- a/controller/relay_audit_test.go
+++ b/controller/relay_audit_test.go
@@ -51,3 +51,26 @@ func TestExtractResponsesMessagesMarksUnassignedInputRawOnly(t *testing.T) {
 	require.Nil(t, messages)
 	require.Equal(t, "raw_only", status)
 }
+
+func TestExtractAnthropicMessagesPreservesSystemAndRoleStructure(t *testing.T) {
+	body := []byte(`{"model":"claude-test","system":[{"type":"text","text":"policy","cache_control":{"type":"ephemeral"}}],"messages":[{"role":"user","content":[{"type":"text","text":"question"},{"type":"image","source":{"type":"base64","media_type":"image/png","data":"abc"}}]},{"role":"assistant","content":[{"type":"tool_use","id":"tool-1","name":"lookup","input":{"q":"audit"}}]}]}`)
+	messages, status := extractAnthropicMessages(&dto.ClaudeRequest{}, body)
+
+	require.Equal(t, "available", status)
+	var expected struct {
+		System   json.RawMessage   `json:"system"`
+		Messages []json.RawMessage `json:"messages"`
+	}
+	require.NoError(t, json.Unmarshal(body, &expected))
+	system, err := json.Marshal(map[string]json.RawMessage{"role": json.RawMessage(`"system"`), "content": expected.System})
+	require.NoError(t, err)
+	expectedMessages, err := json.Marshal(append([]json.RawMessage{system}, expected.Messages...))
+	require.NoError(t, err)
+	require.JSONEq(t, string(expectedMessages), string(messages))
+}
+
+func TestExtractAnthropicMessagesDoesNotGuessUnknownRoles(t *testing.T) {
+	messages, status := extractAnthropicMessages(&dto.ClaudeRequest{}, []byte(`{"model":"claude-test","messages":[{"content":"unknown"}]}`))
+	require.Nil(t, messages)
+	require.Equal(t, "raw_only", status)
+}
