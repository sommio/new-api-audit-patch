-func auditMessages(c *gin.Context, request dto.Request, relayMode int) (json.RawMessage, string) {
+func auditMessages(c *gin.Context, request dto.Request, relayFormat types.RelayFormat, relayMode int) (json.RawMessage, string) {
+	switch relayFormat {
+	case types.RelayFormatClaude:
+	case types.RelayFormatOpenAI:
