+func TestRequestEventPreservesStructuredMessages(t *testing.T) {
+	messages := json.RawMessage(`[{"role":"developer","content":"constraints"},{"role":"assistant","content":null,"tool_calls":[{"id":"call-1","type":"function","function":{"name":"lookup","arguments":"{}"}}]},{"role":"tool","tool_call_id":"call-1","content":[{"type":"text","text":"result"},{"type":"image_url","image_url":{"url":"https://example.test/image.png"}}]}]`)
+	body, err := json.Marshal(RequestEvent{RequestId: "req-1", Messages: messages, MessagesStatus: "available"})
+	require.NoError(t, err)
