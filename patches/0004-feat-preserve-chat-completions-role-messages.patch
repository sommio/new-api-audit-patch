+func auditMessages(c *gin.Context, request dto.Request, relayMode int) (json.RawMessage, string) {
+	if relayMode != relayconstant.RelayModeChatCompletions {
+		return nil, "raw_only"
+	}
+	storage, err := common.GetBodyStorage(c)
+	if err != nil {
+		return nil, "unreadable"
+	}
+	body, err := storage.Bytes()
+	if err != nil {
+		return nil, "unreadable"
+	}
+	return extractChatMessages(request, body)
+}
+
+func extractChatMessages(request dto.Request, body []byte) (json.RawMessage, string) {
+	if _, ok := request.(*dto.GeneralOpenAIRequest); !ok {
+		return nil, "raw_only"
+	}
+	var envelope struct {
+		Messages json.RawMessage `json:"messages"`
+	}
+	if err := json.Unmarshal(body, &envelope); err != nil {
+		return nil, "unreadable"
+	}
+	if len(envelope.Messages) == 0 || string(envelope.Messages) == "null" {
+		return nil, "raw_only"
+	}
+	if !json.Valid(envelope.Messages) {
+		return nil, "unreadable"
+	}
+	var messages []json.RawMessage
+	if err := json.Unmarshal(envelope.Messages, &messages); err != nil || len(messages) == 0 {
+		return nil, "raw_only"
+	}
+	return envelope.Messages, "available"
+}
+
 func auditConversation(c *gin.Context, request dto.Request) (string, string) {
 	if value := strings.TrimSpace(c.GetHeader("Session_id")); value != "" {
 		return audit.ConversationID(value), "session_id"
diff --git a/controller/relay_audit_test.go b/controller/relay_audit_test.go
new file mode 100644
index 00000000..b61c2a36
--- /dev/null
+++ b/controller/relay_audit_test.go
@@ -0,0 +1,31 @@
+package controller
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/stretchr/testify/require"
+)
+
+func TestExtractChatMessagesPreservesOriginalRoleStructure(t *testing.T) {
+	body := []byte(`{"model":"gpt-test","messages":[{"role":"developer","content":"constraints"},{"role":"assistant","content":null,"tool_calls":[{"id":"call-1","type":"function","function":{"name":"lookup","arguments":"{}"}}]},{"role":"tool","tool_call_id":"call-1","content":[{"type":"text","text":"result"},{"type":"image_url","image_url":{"url":"https://example.test/image.png"}}]}]}`)
+	messages, status := extractChatMessages(&dto.GeneralOpenAIRequest{}, body)
+
+	require.Equal(t, "available", status)
+	var expected struct {
+		Messages json.RawMessage `json:"messages"`
+	}
+	require.NoError(t, json.Unmarshal(body, &expected))
+	require.JSONEq(t, string(expected.Messages), string(messages))
+}
+
+func TestExtractChatMessagesMarksNonRoleRequestsRawOnly(t *testing.T) {
+	messages, status := extractChatMessages(&dto.BaseRequest{}, []byte(`{"prompt":"plain completion"}`))
+	require.Nil(t, messages)
+	require.Equal(t, "raw_only", status)
+
+	messages, status = extractChatMessages(&dto.GeneralOpenAIRequest{}, []byte(`{"model":"fim","prefix":"a","suffix":"b"}`))
+	require.Nil(t, messages)
+	require.Equal(t, "raw_only", status)
+}
