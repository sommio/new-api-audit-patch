+// SQLite 并发测试必须使用生产的连接级等待和事务锁配置，而不是裸文件 DSN。
+func TestSecuritySQLiteUsesConcurrentWriteSettings(t *testing.T) {
+	db, dsn := newSecurityTestDatabase(t, "sqlite", "")
+	connection, err := db.DB()
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, connection.Close()) })
+	_, query, ok := strings.Cut(dsn, "?")
+	require.True(t, ok, "fixture must preserve connection settings when reopened")
+	params, err := url.ParseQuery(query)
+	require.NoError(t, err)
+	assert.Equal(t, "immediate", params.Get("_txlock"))
+	// 同时持有两个连接，防止仅首个连接的 PRAGMA 被设置而误报通过。
+	for range 2 {
+		conn, err := connection.Conn(context.Background())
+		require.NoError(t, err)
+		t.Cleanup(func() { require.NoError(t, conn.Close()) })
+		var timeout int
+		var journal string
+		require.NoError(t, conn.QueryRowContext(context.Background(), "PRAGMA busy_timeout").Scan(&timeout))
+		require.NoError(t, conn.QueryRowContext(context.Background(), "PRAGMA journal_mode").Scan(&journal))
+		assert.Equal(t, 30000, timeout)
+		assert.Equal(t, "wal", journal)
+	}
+}
+
+// 安全验证使用生产 SQLite 锁配置；通用夹具还承载强制交错读快照的专项测试，不能全局替换。
+func newSecurityTestDatabase(t *testing.T, kind, dsn string) (*gorm.DB, string) {
+	t.Helper()
+	if kind != "sqlite" {
+		return newAuditTestDatabase(t, kind, dsn)
+	}
+	// 与 common.SQLitePath 的生产默认一致，保留多连接与并发请求。
+	path := t.TempDir() + "/security.db?_pragma=busy_timeout(30000)&_pragma=journal_mode(WAL)&_txlock=immediate"
+	db, err := gorm.Open(sqlite.Open(path), &gorm.Config{})
+	require.NoError(t, err)
+	connection, err := db.DB()
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, connection.Close()) })
+	return db, path
+}
