diff --git a/controller/relay.go b/controller/relay.go
index 15a21f650a5a7c0d6ffce68c5fe9c4d94d2c6728..dd3bcdf3e0b25bd9fbdf37eff2473ac9bdf7d865 100644
--- a/controller/relay.go
+++ b/controller/relay.go
@@ -294,7 +294,7 @@ func CountClaudeTokens(c *gin.Context) {
 func auditMessages(c *gin.Context, request dto.Request, relayFormat types.RelayFormat, relayMode int) (json.RawMessage, string) {
 	switch relayFormat {
 	case types.RelayFormatClaude:
-	case types.RelayFormatOpenAI, types.RelayFormatGemini:
+	case types.RelayFormatOpenAI, types.RelayFormatOpenAIResponses, types.RelayFormatOpenAIResponsesCompaction, types.RelayFormatGemini:
 	default:
 		return nil, "raw_only"
 	}
@@ -351,7 +351,9 @@ func extractChatMessages(request dto.Request, body []byte) (json.RawMessage, str
 }
 
 func extractResponsesMessages(request dto.Request, body []byte) (json.RawMessage, string) {
-	if _, ok := request.(*dto.OpenAIResponsesRequest); !ok {
+	switch request.(type) {
+	case *dto.OpenAIResponsesRequest, *dto.OpenAIResponsesCompactionRequest:
+	default:
 		return nil, "raw_only"
 	}
 	var envelope struct {
diff --git a/controller/relay_audit_test.go b/controller/relay_audit_test.go
index 318d23306cab8587e85cea0d644a5939c5cf0af7..b0a52e4f3b955f794cd40b269ba31c6131d782b7 100644
--- a/controller/relay_audit_test.go
+++ b/controller/relay_audit_test.go
@@ -2,9 +2,16 @@ package controller
 
 import (
 	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
 	"testing"
 
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/relay/constant"
 	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/QuantumNous/new-api/relaykit/types"
+	"github.com/gin-gonic/gin"
 	"github.com/stretchr/testify/require"
 )
 
@@ -101,3 +108,31 @@ func TestExtractGeminiMessagesMarksUnassignedOrNonConversationRequestsRawOnly(t
 	require.Nil(t, messages)
 	require.Equal(t, "raw_only", status)
 }
+
+func TestAuditMessagesPreservesSupportedProtocolMatrix(t *testing.T) {
+	for _, test := range []struct {
+		name        string
+		request     dto.Request
+		relayFormat types.RelayFormat
+		relayMode   int
+		body        string
+	}{
+		{"chat_completions", &dto.GeneralOpenAIRequest{}, types.RelayFormatOpenAI, constant.RelayModeChatCompletions, `{"messages":[{"role":"user","content":"question"}]}`},
+		{"responses", &dto.OpenAIResponsesRequest{}, types.RelayFormatOpenAIResponses, constant.RelayModeResponses, `{"input":[{"role":"developer","content":"constraints"},{"role":"user","content":"question"}]}`},
+		{"responses_compaction", &dto.OpenAIResponsesCompactionRequest{}, types.RelayFormatOpenAIResponsesCompaction, constant.RelayModeResponsesCompact, `{"input":[{"role":"developer","content":"constraints"},{"role":"user","content":"question"}]}`},
+		{"anthropic", &dto.ClaudeRequest{}, types.RelayFormatClaude, constant.RelayModeUnknown, `{"messages":[{"role":"user","content":"question"}]}`},
+		{"gemini", &dto.GeminiChatRequest{}, types.RelayFormatGemini, constant.RelayModeGemini, `{"contents":[{"role":"user","parts":[{"text":"question"}]}]}`},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			recorder := httptest.NewRecorder()
+			context, _ := gin.CreateTestContext(recorder)
+			context.Request = httptest.NewRequest(http.MethodPost, "/", strings.NewReader(test.body))
+			defer common.CleanupBodyStorage(context)
+
+			messages, status := auditMessages(context, test.request, test.relayFormat, test.relayMode)
+
+			require.Equal(t, "available", status)
+			require.NotEmpty(t, messages)
+		})
+	}
+}
