+func ConversationID(raw string) string {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return ""
+	}
+	c := getConfig()
+	if c.secret == "" {
+		return ""
+	}
+	mac := hmac.New(sha256.New, []byte(c.secret))
+	mac.Write([]byte("new-api-audit/conversation\x00"))
+	mac.Write([]byte(raw))
+	return hex.EncodeToString(mac.Sum(nil))
+}
