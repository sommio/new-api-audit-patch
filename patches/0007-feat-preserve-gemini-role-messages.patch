 		return extractChatMessages(request, body)
@@ -426,6 +434,67 @@ func extractAnthropicMessages(request dto.Request, body []byte) (json.RawMessage
 	return result, "available"
 }
 
+func extractGeminiMessages(request dto.Request, body []byte) (json.RawMessage, string) {
+	if _, ok := request.(*dto.GeminiChatRequest); !ok {
+		return nil, "raw_only"
+	}
+	var envelope struct {
+		SystemInstruction      json.RawMessage `json:"systemInstruction"`
+		SystemInstructionSnake json.RawMessage `json:"system_instruction"`
+		Contents               json.RawMessage `json:"contents"`
+	}
+	if err := json.Unmarshal(body, &envelope); err != nil {
+		return nil, "unreadable"
+	}
+
+	messages := make([]json.RawMessage, 0)
+	for _, instruction := range []json.RawMessage{envelope.SystemInstruction, envelope.SystemInstructionSnake} {
+		if len(instruction) == 0 || string(instruction) == "null" {
+			continue
+		}
+		system, err := json.Marshal(struct {
+			Role    string          `json:"role"`
+			Content json.RawMessage `json:"content"`
+		}{Role: "system", Content: instruction})
+		if err != nil {
+			return nil, "unreadable"
+		}
+		messages = append(messages, system)
+	}
+	if len(envelope.Contents) == 0 || string(envelope.Contents) == "null" {
+		if len(messages) == 0 {
+			return nil, "raw_only"
+		}
+		result, err := json.Marshal(messages)
+		if err != nil {
+			return nil, "unreadable"
+		}
+		return result, "available"
+	}
+
+	var contents []json.RawMessage
+	if err := json.Unmarshal(envelope.Contents, &contents); err != nil || len(contents) == 0 {
+		return nil, "raw_only"
+	}
+	for _, content := range contents {
+		var role struct {
+			Role string `json:"role"`
+		}
+		if err := json.Unmarshal(content, &role); err != nil {
+			return nil, "unreadable"
+		}
+		if role.Role != "user" && role.Role != "model" {
+			return nil, "raw_only"
+		}
+		messages = append(messages, content)
+	}
+	result, err := json.Marshal(messages)
+	if err != nil {
+		return nil, "unreadable"
+	}
+	return result, "available"
+}
+
 func auditConversation(c *gin.Context, request dto.Request) (string, string) {
 	if value := strings.TrimSpace(c.GetHeader("Session_id")); value != "" {
 		return audit.ConversationID(value), "session_id"
diff --git a/controller/relay_audit_test.go b/controller/relay_audit_test.go
index ae5197e5..318d2330 100644
--- a/controller/relay_audit_test.go
+++ b/controller/relay_audit_test.go
@@ -74,3 +74,30 @@ func TestExtractAnthropicMessagesDoesNotGuessUnknownRoles(t *testing.T) {
 	require.Nil(t, messages)
 	require.Equal(t, "raw_only", status)
 }
+
+func TestExtractGeminiMessagesPreservesSystemAndRoleStructure(t *testing.T) {
+	body := []byte(`{"systemInstruction":{"parts":[{"text":"policy","custom":{"keep":true}}]},"contents":[{"role":"user","parts":[{"text":"question"},{"inlineData":{"mimeType":"image/png","data":"abc"}}]},{"role":"model","parts":[{"functionCall":{"name":"lookup","args":{"q":"audit"}}}]},{"role":"user","parts":[{"functionResponse":{"name":"lookup","response":{"ok":true}}}]}]}`)
+	messages, status := extractGeminiMessages(&dto.GeminiChatRequest{}, body)
+
+	require.Equal(t, "available", status)
+	var expected struct {
+		SystemInstruction json.RawMessage   `json:"systemInstruction"`
+		Contents          []json.RawMessage `json:"contents"`
+	}
+	require.NoError(t, json.Unmarshal(body, &expected))
+	system, err := json.Marshal(map[string]json.RawMessage{"role": json.RawMessage(`"system"`), "content": expected.SystemInstruction})
+	require.NoError(t, err)
+	expectedMessages, err := json.Marshal(append([]json.RawMessage{system}, expected.Contents...))
+	require.NoError(t, err)
+	require.JSONEq(t, string(expectedMessages), string(messages))
+}
+
+func TestExtractGeminiMessagesMarksUnassignedOrNonConversationRequestsRawOnly(t *testing.T) {
+	messages, status := extractGeminiMessages(&dto.GeminiChatRequest{}, []byte(`{"contents":[{"parts":[{"text":"implicit user"}]}]}`))
+	require.Nil(t, messages)
+	require.Equal(t, "raw_only", status)
+
+	messages, status = extractGeminiMessages(&dto.GeminiEmbeddingRequest{}, []byte(`{"content":{"parts":[{"text":"embedding"}]}}`))
+	require.Nil(t, messages)
+	require.Equal(t, "raw_only", status)
+}
