+
+// 真实 WS + 原有逐请求鉴权 + 异步 webhook，不能用直接调用采集函数替代。
+func TestResponsesWebSocketAuditLifecycle(t *testing.T) {
+	mode := os.Getenv("TEST_WS_AUDIT_MODE")
+	if mode == "" {
+		binary, err := os.Executable()
+		require.NoError(t, err)
+		for _, mode := range []string{"enabled", "disabled", "excluded", "receiver-error", "retry", "saturated"} {
+			t.Run(mode, func(t *testing.T) {
+				cmd := exec.Command(binary, "-test.run=^TestResponsesWebSocketAuditLifecycle$", "-test.timeout=30s")
+				cmd.Env = append(os.Environ(), "TEST_WS_AUDIT_MODE="+mode)
+				output, err := cmd.CombinedOutput()
+				require.NoError(t, err, "%s", output)
+			})
+		}
+		return
+	}
+	type delivery struct {
+		path string
+		body []byte
+	}
+	received := make(chan delivery, 32)
+	unblock := make(chan struct{})
+	receiver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if !assert.NoError(t, err) {
+			w.WriteHeader(400)
+			return
+		}
+		received <- delivery{r.URL.Path, body}
+		if mode == "saturated" {
+			<-unblock
+		}
+		if mode == "receiver-error" {
+			w.WriteHeader(503)
+		}
+	}))
+	defer receiver.Close()
+	defer close(unblock)
+	t.Setenv("AUDIT_ENABLED", fmt.Sprint(mode != "disabled"))
+	t.Setenv("AUDIT_ENDPOINT", receiver.URL)
+	t.Setenv("AUDIT_SECRET", "test-only-secret")
+	t.Setenv("AUDIT_TIMEOUT_MS", "1000")
+	if mode == "saturated" {
+		t.Setenv("AUDIT_QUEUE_SIZE", "1")
+		t.Setenv("AUDIT_TIMEOUT_MS", "20000")
+	}
+	t.Setenv("AUDIT_EXCLUDED_TOKEN_NAMES", "excluded-token")
+	fixture := newResponsesWSBillingTest(t, `tier("base", p * 2)`, func(ws *websocket.Conn, _ *http.Request) {
+		for index := 1; ; index++ {
+			if _, _, err := ws.ReadMessage(); err != nil {
+				return
+			}
+			terminal := fmt.Sprintf(`{"type":"response.completed","response":{"id":"resp_%d","status":"completed","model":"ws-billing","output":[],"usage":{"input_tokens":%d,"output_tokens":2,"total_tokens":%d}}}`, index, index+10, index+12)
+			if !assert.NoError(t, ws.WriteMessage(websocket.TextMessage, []byte(terminal))) {
+				return
+			}
+		}
+	})
+
+	var failedDials atomic.Int32
+	if mode == "retry" {
+		previousRetry := common.RetryTimes
+		common.RetryTimes = 1
+		defer func() { common.RetryTimes = previousRetry }()
+		badUpstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			failedDials.Add(1)
+			w.WriteHeader(http.StatusServiceUnavailable)
+		}))
+		defer badUpstream.Close()
+		badChannel := *fixture.channel
+		badChannel.Id = 0
+		badChannel.Priority = common.GetPointer(int64(100))
+		badChannel.BaseURL = &badUpstream.URL
+		require.NoError(t, model.DB.Create(&badChannel).Error)
+		require.NoError(t, model.DB.Create(&model.Ability{ChannelId: badChannel.Id, Model: "ws-billing", Group: "default", Enabled: true, Priority: badChannel.Priority}).Error)
+		defer func() {
+			require.NoError(t, model.DB.Where("channel_id = ?", badChannel.Id).Delete(&model.Ability{}).Error)
+			require.NoError(t, model.DB.Delete(&badChannel).Error)
+		}()
+	}
+	name := "audited-token"
+	if mode == "excluded" {
+		name = "excluded-token"
+	}
+	require.NoError(t, model.DB.Model(fixture.token).Update("name", name).Error)
+	require.NoError(t, model.InvalidateUserTokensCache(fixture.user.Id))
+	payloads := []string{
+		`{"type":"response.create","model":"ws-billing","prompt_cache_key":"ws-test-session","input":[{"role":"user","content":"ws-first-marker"}]}`,
+		`{"type":"response.create","response":{"model":"ws-billing","prompt_cache_key":"ws-test-session","previous_response_id":"resp_1","input":[{"role":"developer","content":"ws-second-marker"}]}}`,
+		`{"type":"response.create","model":"ws-billing","input":"ws-raw-marker"}`,
+	}
+	for _, payload := range payloads {
+		require.NoError(t, fixture.client.WriteMessage(websocket.TextMessage, []byte(payload)))
+		require.NoError(t, fixture.client.SetReadDeadline(time.Now().Add(3*time.Second)))
+		_, body, err := fixture.client.ReadMessage()
+		require.NoError(t, err)
+		assert.Contains(t, string(body), `"response.completed"`)
+	}
+
+	// 格式和连接模型约束失败都不能留下正常请求内容。
+	for _, invalid := range []string{
+		`{"type":"response.create","input":"invalid-missing-model"}`,
+		`{"type":"response.create","model":"other-model","input":"invalid-model-switch"}`,
+		`{"type":"response.create","model":123,"input":"invalid-model-type"}`,
+	} {
+		require.NoError(t, fixture.client.WriteMessage(websocket.TextMessage, []byte(invalid)))
+		require.NoError(t, fixture.client.SetReadDeadline(time.Now().Add(3*time.Second)))
+		_, body, err := fixture.client.ReadMessage()
+		require.NoError(t, err)
+		assert.Contains(t, string(body), `"error"`)
+	}
+	require.NoError(t, model.DB.Model(fixture.token).Update("status", common.TokenStatusDisabled).Error)
+	require.NoError(t, model.InvalidateUserTokensCache(fixture.user.Id))
+	require.NoError(t, fixture.client.WriteMessage(websocket.TextMessage, []byte(payloads[0])))
+	_, rejected, err := fixture.client.ReadMessage()
+	require.NoError(t, err)
+	assert.Contains(t, string(rejected), `"error"`)
+	fixture.closeAndWait(t)
+	if mode == "saturated" {
+		// 三次中继已终止，但接收端仍被锁住，容量 1 的队列已丢弃多余事件。
+		select {
+		case event := <-received:
+			assert.True(t, strings.HasSuffix(event.path, "/request"))
+		case <-time.After(3 * time.Second):
+			t.Fatal("sender did not reach blocked receiver")
+		}
+		return
+	}
+	if mode == "disabled" {
+		require.Empty(t, received)
+		return
+	}
+	// sender 单 worker FIFO：屏障确保检查覆盖所有已入队事件，而不是任意 sleep。
+	audit.EnqueueUsage(audit.UsageEvent{RequestId: "ws-audit-barrier", TokenName: "audited-token"})
+	requests := map[string]audit.RequestEvent{}
+	usages := map[string]audit.UsageEvent{}
+	timeout := time.After(3 * time.Second)
+collect:
+	for {
+		select {
+		case event := <-received:
+			if strings.HasSuffix(event.path, "/request") {
+				var request audit.RequestEvent
+				require.NoError(t, common.Unmarshal(event.body, &request))
+				assert.NotContains(t, requests, request.RequestId, "request must not be enqueued twice")
+				requests[request.RequestId] = request
+			} else {
+				var usage audit.UsageEvent
+				require.NoError(t, common.Unmarshal(event.body, &usage))
+				if usage.RequestId == "ws-audit-barrier" {
+					break collect
+				}
+				assert.NotContains(t, usages, usage.RequestId)
+				usages[usage.RequestId] = usage
+			}
+		case <-timeout:
+			t.Fatal("audit delivery timed out")
+		}
+	}
+	if mode == "excluded" {
+		require.Empty(t, requests)
+		require.Empty(t, usages)
+		return
+	}
+	require.Len(t, requests, 3, "accepted WS messages must have request evidence, not only usage")
+	require.Len(t, usages, 3)
+	for index, marker := range []string{"ws-first-marker", "ws-second-marker", "ws-raw-marker"} {
+		id := fmt.Sprintf("responses-ws-billing-ws-%d", index)
+		event := requests[id]
+		assert.LessOrEqual(t, len(id), 96)
+		assert.Equal(t, fixture.user.Id, event.UserId)
+		assert.Equal(t, fixture.token.Id, event.TokenId)
+		assert.Equal(t, "ws-billing", event.ModelName, "capture before channel mapping")
+		assert.Equal(t, "/v1/responses", event.RequestPath)
+		assert.Equal(t, string(types.RelayFormatOpenAIResponses), event.RelayFormat)
+		assert.True(t, event.IsStream)
+		assert.Equal(t, index+11, usages[id].PromptTokens)
+		if index < 2 {
+			assert.Equal(t, "available", event.MessagesStatus)
+			assert.Contains(t, string(event.Messages), marker)
+			assert.Equal(t, audit.ConversationID("ws-test-session"), event.ConversationID)
+			assert.Equal(t, "prompt_cache_key", event.ConversationSource)
+		} else {
+			assert.Equal(t, "raw_only", event.MessagesStatus)
+			assert.Empty(t, event.Messages)
+			assert.Contains(t, event.PromptText, marker)
+			assert.Empty(t, event.ConversationID)
+		}
+	}
+	assert.NotContains(t, string(requests["responses-ws-billing-ws-1"].Messages), "ws-first-marker")
+	if mode == "retry" {
+		assert.EqualValues(t, 1, failedDials.Load())
+	}
+	require.Empty(t, received, "receiver errors must not trigger sender retries")
+}
