new file mode 100644
index 0000000000000000000000000000000000000000..196e15cd7917f63a3b3ed0507c78feeed9004e1f
--- /dev/null
+++ b/controller/relay_audit.go
@@ -0,0 +1,280 @@
+package controller
+
+import (
+	"encoding/json"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/audit"
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	relayconstant "github.com/QuantumNous/new-api/relay/constant"
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/QuantumNous/new-api/relaykit/types"
+	"github.com/gin-gonic/gin"
+)
+
+// body is an optional validated snapshot. WS must pass its normalized body:
+// middleware body storage may still contain the original response.create frame.
+// Capture before forwarding/retries; never mutate the relay DTO or consume its body.
+func enqueueRelayAudit(c *gin.Context, request dto.Request, format types.RelayFormat, originalModel string, isStream bool, body []byte) {
+	if !audit.EnabledForToken(c.GetString("token_name")) {
+		return
+	}
+	messages, status := auditMessages(c, request, format, relayconstant.Path2RelayMode(c.Request.URL.Path), body)
+	promptText := ""
+	if meta := request.GetTokenCountMeta(); meta != nil {
+		promptText = meta.CombineText
+	}
+	conversationID, source := auditConversation(c, request)
+	audit.EnqueueRequest(audit.RequestEvent{
+		RequestId:          c.GetString(common.RequestIdKey),
+		CreatedAt:          time.Now().UTC().Format(time.RFC3339Nano),
+		UserId:             common.GetContextKeyInt(c, constant.ContextKeyUserId),
+		Username:           c.GetString("username"),
+		TokenId:            common.GetContextKeyInt(c, constant.ContextKeyTokenId),
+		TokenName:          c.GetString("token_name"),
+		ModelName:          originalModel,
+		RequestPath:        c.Request.URL.Path,
+		RelayFormat:        string(format),
+		IsStream:           isStream,
+		PromptHash:         audit.HashText(promptText),
+		PromptPreview:      audit.PreviewText(promptText, 500),
+		PromptText:         promptText,
+		ConversationID:     conversationID,
+		ConversationSource: source,
+		UserDisplayName:    c.GetString("display_name"),
+		Messages:           messages,
+		MessagesStatus:     status,
+	})
+}
+
+func auditMessages(c *gin.Context, request dto.Request, relayFormat types.RelayFormat, relayMode int, body []byte) (json.RawMessage, string) {
+	switch relayFormat {
+	case types.RelayFormatClaude:
+	case types.RelayFormatOpenAI, types.RelayFormatOpenAIResponses, types.RelayFormatOpenAIResponsesCompaction, types.RelayFormatGemini:
+	default:
+		return nil, "raw_only"
+	}
+	if relayFormat == types.RelayFormatGemini {
+		if _, ok := request.(*dto.GeminiChatRequest); !ok {
+			return nil, "raw_only"
+		}
+	}
+	if body == nil {
+		storage, err := common.GetBodyStorage(c)
+		if err != nil {
+			return nil, "unreadable"
+		}
+		body, err = storage.Bytes()
+		if err != nil {
+			return nil, "unreadable"
+		}
+	}
+
+	if relayFormat == types.RelayFormatClaude {
+		return extractAnthropicMessages(request, body)
+	}
+	if relayFormat == types.RelayFormatGemini {
+		return extractGeminiMessages(request, body)
+	}
+	switch relayMode {
+	case relayconstant.RelayModeChatCompletions:
+		return extractChatMessages(request, body)
+	case relayconstant.RelayModeResponses, relayconstant.RelayModeResponsesCompact:
+		return extractResponsesMessages(request, body)
+	default:
+		return nil, "raw_only"
+	}
+}
+
+func extractChatMessages(request dto.Request, body []byte) (json.RawMessage, string) {
+	if _, ok := request.(*dto.GeneralOpenAIRequest); !ok {
+		return nil, "raw_only"
+	}
+	var envelope struct {
+		Messages json.RawMessage `json:"messages"`
+	}
+	if err := common.Unmarshal(body, &envelope); err != nil {
+		return nil, "unreadable"
+	}
+	if len(envelope.Messages) == 0 || string(envelope.Messages) == "null" {
+		return nil, "raw_only"
+	}
+	var messages []json.RawMessage
+	if err := common.Unmarshal(envelope.Messages, &messages); err != nil || len(messages) == 0 {
+		return nil, "raw_only"
+	}
+	return envelope.Messages, "available"
+}
+
+func extractResponsesMessages(request dto.Request, body []byte) (json.RawMessage, string) {
+	switch request.(type) {
+	case *dto.OpenAIResponsesRequest, *dto.OpenAIResponsesCompactionRequest:
+	default:
+		return nil, "raw_only"
+	}
+	var envelope struct {
+		Input json.RawMessage `json:"input"`
+	}
+	if err := common.Unmarshal(body, &envelope); err != nil {
+		return nil, "unreadable"
+	}
+	if len(envelope.Input) == 0 || string(envelope.Input) == "null" {
+		return nil, "raw_only"
+	}
+	var inputs []struct {
+		Role string `json:"role"`
+		Type string `json:"type"`
+	}
+	if err := common.Unmarshal(envelope.Input, &inputs); err != nil || len(inputs) == 0 {
+		return nil, "raw_only"
+	}
+	for _, input := range inputs {
+		if strings.TrimSpace(input.Role) != "" || input.Type == "function_call" || input.Type == "custom_tool_call" || input.Type == "reasoning" {
+			return envelope.Input, "available"
+		}
+	}
+	return nil, "raw_only"
+}
+
+func extractAnthropicMessages(request dto.Request, body []byte) (json.RawMessage, string) {
+	if _, ok := request.(*dto.ClaudeRequest); !ok {
+		return nil, "raw_only"
+	}
+	var envelope struct {
+		System   json.RawMessage `json:"system"`
+		Messages json.RawMessage `json:"messages"`
+	}
+	if err := common.Unmarshal(body, &envelope); err != nil {
+		return nil, "unreadable"
+	}
+
+	messages := make([]json.RawMessage, 0)
+	if len(envelope.System) > 0 && string(envelope.System) != "null" {
+		system, err := common.Marshal(struct {
+			Role    string          `json:"role"`
+			Content json.RawMessage `json:"content"`
+		}{Role: "system", Content: envelope.System})
+		if err != nil {
+			return nil, "unreadable"
+		}
+		messages = append(messages, system)
+	}
+	if len(envelope.Messages) == 0 || string(envelope.Messages) == "null" {
+		if len(messages) == 0 {
+			return nil, "raw_only"
+		}
+		result, err := common.Marshal(messages)
+		if err != nil {
+			return nil, "unreadable"
+		}
+		return result, "available"
+	}
+
+	var original []json.RawMessage
+	if err := common.Unmarshal(envelope.Messages, &original); err != nil {
+		return nil, "unreadable"
+	}
+	if len(original) == 0 {
+		return nil, "raw_only"
+	}
+	for _, message := range original {
+		var role struct {
+			Role string `json:"role"`
+		}
+		if err := common.Unmarshal(message, &role); err != nil {
+			return nil, "unreadable"
+		}
+		if role.Role != "user" && role.Role != "assistant" {
+			return nil, "raw_only"
+		}
+		messages = append(messages, message)
+	}
+	result, err := common.Marshal(messages)
+	if err != nil {
+		return nil, "unreadable"
+	}
+	return result, "available"
+}
+
+func extractGeminiMessages(request dto.Request, body []byte) (json.RawMessage, string) {
+	if _, ok := request.(*dto.GeminiChatRequest); !ok {
+		return nil, "raw_only"
+	}
+	var envelope struct {
+		SystemInstruction      json.RawMessage `json:"systemInstruction"`
+		SystemInstructionSnake json.RawMessage `json:"system_instruction"`
+		Contents               json.RawMessage `json:"contents"`
+	}
+	if err := common.Unmarshal(body, &envelope); err != nil {
+		return nil, "unreadable"
+	}
+
+	messages := make([]json.RawMessage, 0)
+	for _, instruction := range []json.RawMessage{envelope.SystemInstruction, envelope.SystemInstructionSnake} {
+		if len(instruction) == 0 || string(instruction) == "null" {
+			continue
+		}
+		system, err := common.Marshal(struct {
+			Role    string          `json:"role"`
+			Content json.RawMessage `json:"content"`
+		}{Role: "system", Content: instruction})
+		if err != nil {
+			return nil, "unreadable"
+		}
+		messages = append(messages, system)
+	}
+	if len(envelope.Contents) == 0 || string(envelope.Contents) == "null" {
+		if len(messages) == 0 {
+			return nil, "raw_only"
+		}
+		result, err := common.Marshal(messages)
+		if err != nil {
+			return nil, "unreadable"
+		}
+		return result, "available"
+	}
+
+	var contents []json.RawMessage
+	if err := common.Unmarshal(envelope.Contents, &contents); err != nil || len(contents) == 0 {
+		return nil, "raw_only"
+	}
+	for _, content := range contents {
+		var role struct {
+			Role string `json:"role"`
+		}
+		if err := common.Unmarshal(content, &role); err != nil {
+			return nil, "unreadable"
+		}
+		if role.Role != "user" && role.Role != "model" {
+			return nil, "raw_only"
+		}
+		messages = append(messages, content)
+	}
+	result, err := common.Marshal(messages)
+	if err != nil {
+		return nil, "unreadable"
+	}
+	return result, "available"
+}
+
+func auditConversation(c *gin.Context, request dto.Request) (string, string) {
+	if value := strings.TrimSpace(c.GetHeader("Session_id")); value != "" {
+		return audit.ConversationID(value), "session_id"
+	}
+
+	var value string
+	switch req := request.(type) {
+	case *dto.GeneralOpenAIRequest:
+		value = req.PromptCacheKey
+	case *dto.OpenAIResponsesRequest:
+		if len(req.PromptCacheKey) > 0 {
+			_ = common.Unmarshal(req.PromptCacheKey, &value)
+		}
+	}
+	if strings.TrimSpace(value) == "" {
+		return "", ""
+	}
+	return audit.ConversationID(value), "prompt_cache_key"
+}
